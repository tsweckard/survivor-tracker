# Trihydro Claude Code - Project Ignore File
# Works like .gitignore — patterns listed here are excluded from Claude's context.
# Copy this file to the root of your project as: .claudeignore

# Environment and local configuration
.env
.env.*
*.env
.env.local
.env.development
.env.staging
.env.production

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.keystore
*.jks

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub

# Cloud provider credentials
.aws/
.azure/
.gcloud/
gcloud/
application_default_credentials.json
service-account*.json

# Secrets and tokens
*secrets*.json
*.secret
secrets/
.secrets/
*token*.json
*password*
*credential*

# .NET user secrets and environment-specific config
appsettings.Production.json
appsettings.Staging.json
appsettings.Local.json

# Package manager lock files (large, rarely useful to Claude)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output and dependencies
node_modules/
dist/
build/
bin/
obj/
out/
.next/
target/

# IDE and OS artifacts
.DS_Store
Thumbs.db
*.suo
*.user
.vs/
